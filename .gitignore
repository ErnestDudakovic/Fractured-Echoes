# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures
/[Mm]emoryCaptures/

# Recordings
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Streaming Assets
/[Aa]ssets/StreamingAssets/

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Rider solution and project files
ExportedObj/
.consignore
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.slnx

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Burst debug information
/[Aa]ssets/Burst*

# JetBrains Rider
.idea/

# Firebase credentials — NEVER commit
Assets/google-services.json
Assets/google-services.json.meta
Assets/GoogleService-Info.plist
Assets/GoogleService-Info.plist.meta

# Firebase plugin binaries >100MB (GitHub limit)
Assets/Firebase/Plugins/**/FirebaseCppApp-*.bundle
Assets/Firebase/Plugins/**/FirebaseCppApp-*.so

# ---------------------------------------------------------------------------
# Firebase heavy binaries — excluded to keep the repo small enough to push.
# These are restored by re-importing the Firebase Unity SDK; they don't need
# to live in version control. iOS/tvOS native libs are useless for a desktop
# build. If you ever build for those platforms, re-import the SDK locally.
# ---------------------------------------------------------------------------

# Native static libs for mobile/TV platforms (not needed for desktop)
Assets/Plugins/iOS/Firebase/
Assets/Plugins/tvOS/Firebase/

# Firebase desktop/editor native binaries (restored by SDK re-import)
Assets/Firebase/Plugins/
Assets/Firebase/m2repository/
Assets/Firebase/Editor/*.exe

# Compiled Firebase native libs anywhere under Assets
Assets/Plugins/**/libFirebaseCpp*.a
Assets/Plugins/**/FirebaseCppApp*.dll

# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# VS Code
.vscode/

# GitHub Copilot
.github/copilot*