  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 411e218e5a0c97e4f849660e5457bc2b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NoteInteractable
  Title: Key Log
  Body: 'House key: opens this door. Reception held it, east side of

    the road,
    past the lamps.


    Cabin key: upstairs in this building. Do not go up without
    a

    light. I mean that literally, not as advice.


    Room key: not written
    down. Ask the water.


    Whoever is next: the stairs are safe. The landing
    is not.

    Read what is on the landing and then keep moving.'
  ReadSound: {fileID: 0}
  SanityOnFirstRead: 0
  DisappearAfterReading: 0
