--- !u!114 &607840806
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 607840804}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 411e218e5a0c97e4f849660e5457bc2b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NoteInteractable
  Title: Session Transcript - Fragment
  Body: "H: Tell me what you saw in the east wing.\nP: A man standing at the end
    of it. Not moving.\nH: Did he approach you?\nP: No. He waited until I looked
    away.\nH: And then?\nP: And then he was closer. That is how they work.\n   You
    know that. You wrote it down last time.\nH: I have not written anything yet today.\nP:
    You will.\n\n[margin, different hand] They cannot follow far. They lose\ninterest.
    Do not stop moving and do not stop to look."
  ReadSound: {fileID: 0}
  SanityOnFirstRead: -8
  DisappearAfterReading: 0
