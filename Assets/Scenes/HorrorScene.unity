  m_Script: {fileID: 11500000, guid: 411e218e5a0c97e4f849660e5457bc2b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NoteInteractable
  Title: Torn Page
  Body: '-- did not want to frighten anyone but the count is wrong.

    Twelve admitted.
    Twelve beds. Thirteen meals returned to the

    kitchen every single evening
    for six weeks.


    We stopped counting rather than answer the question.


    Halloway
    took the room key east when the water came up. The

    building out past the
    far shore, the one standing in the

    flood. That is where he went. Nobody
    has been back for it.'
  ReadSound: {fileID: 0}
  SanityOnFirstRead: -6
  DisappearAfterReading: 0
