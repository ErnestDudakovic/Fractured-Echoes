  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 411e218e5a0c97e4f849660e5457bc2b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NoteInteractable
  Title: Incident Report - Redacted
  Body: 'At approximately 02:00 the night warden reported hearing his

    own voice
    from inside Room 4. He entered. Room 4 was empty.


    He reported this to me
    at 02:00 the following night, in the

    same words, with the same tremor.


    I
    checked the roster. He has not been employed here since

    the closure.


    The
    cabin key is on this landing. The cabins are west, down

    the track past the
    bridge. Two of them are locked and the

    same key opens both.'
  ReadSound: {fileID: 0}
  SanityOnFirstRead: -10
  DisappearAfterReading: 0
