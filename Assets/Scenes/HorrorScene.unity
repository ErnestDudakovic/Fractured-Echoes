  m_Script: {fileID: 11500000, guid: 411e218e5a0c97e4f849660e5457bc2b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NoteInteractable
  Title: Intake Form - Room 4
  Body: 'Patient admitted 03:40. No identification on his person.

    Responsive
    but will not give a name.


    Repeats the same sentence to every question:

    "I
    already answered you. You asked me an hour ago."


    No prior visit on record.
    Nobody spoke to him an hour ago.


    [warden''s addition] Sent him up the north
    road to the

    crossroads. The lamps there still work. He can wait under

    them
    until someone comes for him.'
  ReadSound: {fileID: 0}
  SanityOnFirstRead: -3
  DisappearAfterReading: 0
