  m_Script: {fileID: 11500000, guid: cbb6b07361ad4294ca38d2e42f894dab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FracturedEchoes.Interaction.NoteInteractable
  _promptText: Read the manager's letter
  _interactionType: 2
  _canInteract: 1
  _singleUse: 0
  _cooldown: 0
  _highlightColor: {r: 1, g: 1, b: 1, a: 0.3}
  _enableHighlight: 1
  _interactSound: {fileID: 0}
  _soundVolume: 1
  _onInteracted: {fileID: 0}
  _noteTitle: Building Manager's Letter
  _noteText: "Mr. Kova\u010D,\n\nThe keys are yours now. Nobody has lived on this
    floor since your family... since that winter. I kept the power on, though half
    the lights do what they want.\n\nThe bedroom is locked \u2014 your sister always
    hid the brass key somewhere in the living quarters. The cellar I never go into.
    You'll understand why.\n\nTake what you came for and leave before dark.\n\n\u2014
    D."
  _sanityOnFirstRead: 0
