  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FracturedEchoes.Interaction.NoteInteractable
  _promptText: Read the page nailed to the crate
  _interactionType: 2
  _canInteract: 1
  _singleUse: 0
  _cooldown: 0
  _highlightColor: {r: 1, g: 1, b: 1, a: 0.3}
  _enableHighlight: 1
  _interactSound: {fileID: 0}
  _soundVolume: 1
  _onInteracted: {fileID: 0}
  _noteTitle: A Page In Your Own Handwriting
  _noteText: "You shouldn't have come back.\n\nYou were here that winter. You heard
    the humming too \u2014 you just chose to forget. The building remembers what
    you did with the candles.\n\nIt has been waiting for you to open the seal again.\n\n       
    \u2014 \u2014 \u2014  END OF DEMO  \u2014 \u2014 \u2014\n\nThanks for playing
    this skeleton build of FRACTURED ECHOES."
  _sanityOnFirstRead: -10
