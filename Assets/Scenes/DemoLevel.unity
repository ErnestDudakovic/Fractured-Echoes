  m_Script: {fileID: 11500000, guid: cbb6b07361ad4294ca38d2e42f894dab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FracturedEchoes.Interaction.NoteInteractable
  _promptText: Read the diary page
  _interactionType: 2
  _canInteract: 1
  _singleUse: 0
  _cooldown: 0
  _highlightColor: {r: 1, g: 1, b: 1, a: 0.3}
  _enableHighlight: 1
  _interactSound: {fileID: 0}
  _soundVolume: 1
  _onInteracted: {fileID: 0}
  _noteTitle: Torn Diary Page
  _noteText: '...Marta keeps hiding the bedroom key again. She says the room "hums"
    at night and no one should go in.


    I found it last time behind the old dresser,
    by the far wall. She never hides it anywhere new.


    The pills the doctor
    gave her are on the shelf. She stopped taking them. She says they make the humming
    louder...'
  _sanityOnFirstRead: -3
